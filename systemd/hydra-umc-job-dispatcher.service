# Loopback-only by default. Another address needs a bearer token: put
# JOB_DISPATCHER_TOKEN=... in /etc/hydra-umc/job-dispatcher.env (read below) and
# change --addr.
[Unit]
Description=HYDRA-UMC-JOB-DISPATCHER real priority mission queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-job-dispatcher
Group=hydra-umc-job-dispatcher
WorkingDirectory=/opt/hydra-umc/job-dispatcher
EnvironmentFile=-/etc/hydra-umc/job-dispatcher.env
ExecStartPre=+/usr/bin/install -d -o hydra-umc-job-dispatcher -g hydra-umc-job-dispatcher /opt/hydra-umc/job-dispatcher/data
ExecStart=/opt/hydra-umc/job-dispatcher/hydra-umc-job-dispatcher --addr 127.0.0.1:8090 --db /opt/hydra-umc/job-dispatcher/data/job-dispatcher.sqlite3
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/hydra-umc/job-dispatcher/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# A real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
